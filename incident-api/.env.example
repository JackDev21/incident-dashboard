# Environment variables for the Incident API
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/incident-dashboard

# JWT secret used to sign and verify authentication tokens
JWT_SECRET=replace_with_a_long_random_secret

# LLM provider configuration (provider-agnostic)
LLM_PROVIDER=mistral
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=model_name_here
LLM_BASE_URL=base_url_for_llm_api_here